
@model ClinicaVida.Web.Models.Medico

@{
    ViewData["Title"] = "Detalhes do médico";
}

<h1>Detalhes do médico</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">CRM</dt>
    <dd class="col-sm-10">@Model.Crm</dd>

    <dt class="col-sm-2">Especialidade</dt>
    <dd class="col-sm-10">@Model.Especialidade.Nome</dd>
</dl>

<a href="/Medicos" class="btn btn-secondary">
    Voltar à lista
</a>
